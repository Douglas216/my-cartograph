// Cloudflare hosting for My Cartograph (Workers with static assets + D1).
// Cloudflare Workers Builds runs `npm run build`, then `npx wrangler deploy` for main
// and `npx wrangler versions upload` for other branches (each gets a preview link).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "my-cartograph",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "my-cartograph",
      "database_id": "REPLACE_WITH_D1_ID",
      "migrations_dir": "drizzle"
    }
  ],
  "observability": { "enabled": true }
}
